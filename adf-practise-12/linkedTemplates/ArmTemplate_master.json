{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-practise-12"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"files_routes_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'files_routes'"
		},
		"json_file_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'json_file'"
		},
		"sink_rouye_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sink_rouye'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stg12adb.dfs.core.windows.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server1112.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db112"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Pragya"
		},
		"files_routes_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stg12adb.dfs.core.windows.net/"
		},
		"json_file_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stg12adb.dfs.core.windows.net/"
		},
		"sink_rouye_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stg12adb.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-practise-12_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"files_routes_accountKey": {
						"value": "[parameters('files_routes_accountKey')]"
					},
					"json_file_accountKey": {
						"value": "[parameters('json_file_accountKey')]"
					},
					"sink_rouye_accountKey": {
						"value": "[parameters('sink_rouye_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"files_routes_properties_typeProperties_url": {
						"value": "[parameters('files_routes_properties_typeProperties_url')]"
					},
					"json_file_properties_typeProperties_url": {
						"value": "[parameters('json_file_properties_typeProperties_url')]"
					},
					"sink_rouye_properties_typeProperties_url": {
						"value": "[parameters('sink_rouye_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}